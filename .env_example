# Região dos recursos AWS.
AWS_DEFAULT_REGION=us-east-1

# Obrigatório para o orquestrador batch; obtenha o ID da conta com:
# aws sts get-caller-identity
AWS_ACCOUNT_ID=123456789012

# Use um nome base sem sufixo de conta/região: o orquestrador batch
# sempre monta <base>-<AWS_ACCOUNT_ID>-<AWS_DEFAULT_REGION>.
S3_BUCKET_NAME=tc-alfabetizacao

# Nome da role Glue ou ARN completo. A role precisa existir e ter permissões
# para S3, Glue, CloudWatch, Secrets Manager e acesso ao BigQuery.
AWS_GLUE_ROLE_ARN=LabRole

# Segredo que receberá a chave JSON da conta de serviço GCP no deploy.
GCP_BIGQUERY_KEY_SECRET_NAME=pipeline-educacao/gcp/bigquery
GOOGLE_APPLICATION_CREDENTIALS=gcp_key.json

# Retenção da landing de eventos no S3.
LIFECYCLE_RULES_EXPIRATION_DAYS=7

# Regras de qualidade da camada Silver.
JOIN_MATCH_THRESHOLD=95.0
BLOCK_ON_QUALITY_FAILURE=true

# Intervalo de polling dos jobs Glue, em segundos.
GLUE_POLLING_INTERVAL=10

# E-mail opcional do orquestrador local; deixe vazio para desabilitá-lo.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=
