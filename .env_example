# =====================================================================
# AWS Credentials & Region Config
# Rename this file to .env in your local repository
# =====================================================================
AWS_ACCESS_KEY_ID=SEU_ACCESS_KEY_ID_AQUI
AWS_SECRET_ACCESS_KEY=SUA_SECRET_ACCESS_KEY_AQUI
AWS_SESSION_TOKEN=SEU_TOKEN_DE_SESSAO_CASO_USE_AWS_LAB
AWS_DEFAULT_REGION=us-east-1

# =====================================================================
# S3 Data Lake Infrastructure
# =====================================================================
S3_BUCKET_NAME=nome_do_bucket_que_sera_criado_na_aws
S3_PREFIX_BRONZE=bronze/
S3_PREFIX_SILVER=silver/
S3_PREFIX_GOLD=gold/
S3_PREFIX_OBSERVABILITY=observability/

# =====================================================================
# AWS Secret Manager
# =====================================================================
GCP_BIGQUERY_KEY_SECRET_NAME=nome-da-secret-que-contem-as-credenciais-do-gcp-BigQuery

# =====================================================================
# AWS Glue & Athena Catalog Config
# =====================================================================
AWS_GLUE_ROLE_ARN=LabRole
GLUE_DATABASE_BRONZE=db_alfabetizacao_bronze
GLUE_DATABASE_SILVER=db_alfabetizacao_silver
GLUE_DATABASE_GOLD=db_alfabetizacao_gold
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=athena-query-results/

# =====================================================================
# Kinesis Streaming Config
# =====================================================================
KINESIS_STREAM_NAME=stream-medicao-alfabetizacao
KINESIS_SHARD_COUNT=1

# =====================================================================
# Quality Thresholds & Governance
# =====================================================================
JOIN_MATCH_THRESHOLD=0.95
BLOCK_ON_QUALITY_FAILURE=true

# ===================================================================== 
# GCP BigQuery Config 
# ===================================================================== 
GCP_PROJECT_BILLING=ID_DO_SEU_PROJETO_GCP
GOOGLE_APPLICATION_CREDENTIALS=LOCAL_DO_SEU_ARQUIVO_DE_CHAVE_EX:_gcp_key.json